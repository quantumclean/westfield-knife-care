# Copy to .env for local development. Never commit .env.
# The API dev server loads this file; Vite reads the VITE_* keys.

# --- apps/api ---
PORT=8787
STAGE=local
# Public site origin, used for Stripe success/cancel redirects.
SITE_URL=http://localhost:5173
# Comma-separated origins allowed cross-origin. Vite proxies /api, so this rarely matters locally.
CORS_ORIGINS=http://localhost:5173
# Leave empty to simulate checkout (no Stripe calls, orders go straight to the thank-you page).
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:8787/api/webhooks/stripe`.
STRIPE_WEBHOOK_SECRET=
# Protects /api/admin/*. Generate with: openssl rand -hex 24
ADMIN_API_KEY=
# Leave empty to use the in-memory store. Set to a DynamoDB table to test against AWS.
TABLE_NAME=
AWS_REGION=us-east-1

# --- apps/web ---
# Where the browser sends API calls. Default "/api" works with the Vite proxy and CloudFront.
VITE_API_BASE_URL=/api
# Optional Google Analytics 4 measurement id (G-XXXXXXXXXX). Empty disables GA4.
VITE_GA4_MEASUREMENT_ID=
