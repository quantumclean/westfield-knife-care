{
  "name": "@wkc/api",
  "version": "0.1.0",
  "private": true,
  "description": "HTTP API: orders, payments, waitlist, analytics events and operator tools.",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch --experimental-strip-types src/server.ts",
    "build": "node build.mjs",
