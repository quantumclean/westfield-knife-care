    "@aws-sdk/lib-dynamodb": "^3.1139.0",
    "@wkc/shared": "workspace:*",
    "hono": "^4.13.9",
    "stripe": "^22.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.1",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
